{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ai-red-mahjong-online",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MahjongRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "MahjongLobby"
      },
      {
        "name": "SGS_ROOMS",
        "class_name": "SanguoshaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MahjongRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MahjongLobby"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SanguoshaRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-red-mahjong",
      "database_id": "84722346-19ac-4d47-a4c5-34ab75b3cef0",
      "migrations_dir": "migrations"
    }
  ]
}
