{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "crplay-beta-api",
  "main": "dist/worker.js",
  "no_bundle": true,
  "workers_dev": false,
  "compatibility_date": "2026-08-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MahjongRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "MahjongLobby"
      },
      {
        "name": "SGS_ROOMS",
        "class_name": "SanguoshaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MahjongRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MahjongLobby"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SanguoshaRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crplay-beta-db",
      "database_id": "e3671cb5-0b2b-49a1-8d15-3e97ce85fc35",
      "migrations_dir": "migrations"
    }
  ]
}
