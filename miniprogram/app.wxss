/* 默认的 content-box 会让 padding 把宽度撑出容器：手牌排不下要换行、
   面板行右边被截掉，都是这么来的。统一按 border-box 算。 */
view, scroll-view, text, input, picker, button, image, label {
  box-sizing: border-box;
}

/* 全局底色和字号基准。牌桌那套配色沿用网页版，换个地方玩还是同一张桌子。 */
page {
  background: #0b1a15;
  color: #f2ecda;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}
.safe-top { padding-top: env(safe-area-inset-top); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* —— 通用小窗：更多、声音、AI 档位共用，牌桌页和设置页都要用，所以放全局。
   竖屏从底部滑上来，横屏居中显示——横屏只有 390 高，底部弹层几乎占满整屏。 —— */
.sheet-mask { position: fixed; inset: 0; z-index: 26; background: rgba(0,0,0,.5); }
.sheet {
  position: fixed; z-index: 27;
  left: 0; right: 0; bottom: 0;
  max-height: 76vh;
  display: flex; flex-direction: column;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid #35524a;
  background: #0c211b;
  animation: sheet-up .24s ease;
}
.sheet-head {
  flex: none;
  padding: 20rpx 24rpx 14rpx;
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 2rpx solid #1e3a32;
}
.sheet-title { color: #f3d67c; font-size: 30rpx; font-weight: 800; }
.sheet-close { flex: none; width: 56rpx; text-align: center; color: #8ba49c; font-size: 40rpx; line-height: 1; }
.sheet-body {
  flex: 1; min-height: 0; overflow-y: auto;
  padding: 18rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
}
@keyframes sheet-up { from { transform: translateY(100%); } }
@keyframes sheet-pop { from { opacity: 0; transform: translate(-50%, -46%); } }

.sheet-row {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 20rpx 22rpx; margin-bottom: 12rpx;
  border: 2rpx solid #2f4b41; border-radius: 18rpx; background: #102821;
}
.sheet-row.danger { border-color: #6d3a34; }
.sheet-row-name { color: #eee4c8; font-size: 28rpx; font-weight: 700; }
.sheet-row.danger .sheet-row-name { color: #e9a79f; }
.sheet-row-value { color: #7f948d; font-size: 22rpx; }
.sheet-slider { padding: 2rpx 22rpx 16rpx; }
.sheet-slider-label { display: block; margin-bottom: 4rpx; color: #7f948d; font-size: 21rpx; }
.sheet-picker {
  min-width: 150rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  border: 2rpx solid #4a6357; border-radius: 12rpx;
  background: #16332a; color: #f3d67c; font-size: 25rpx; font-weight: 700;
}

@media (orientation: landscape) {
  .sheet {
    left: 50%; right: auto; bottom: auto; top: 50%;
    width: min(440px, 72vw);
    max-height: 82vh;
    transform: translate(-50%, -50%);
    border-radius: 12px;
    border: 1px solid #35524a;
    animation: sheet-pop .2s ease;
  }
  .sheet-head { padding: 8px 12px 7px; border-bottom-width: 1px; }
  .sheet-title { font-size: 14px; }
  .sheet-close { width: 26px; font-size: 20px; }
  .sheet-body { padding: 8px 12px calc(10px + env(safe-area-inset-bottom)); }
  .sheet-row { padding: 7px 10px; margin-bottom: 6px; border-radius: 8px; border-width: 1px; gap: 8px; }
  .sheet-row-name { font-size: 12px; }
  .sheet-row-value { font-size: 10px; }
  .sheet-slider { padding: 0 10px 6px; }
  .sheet-slider-label { margin-bottom: 1px; font-size: 9px; }
  .sheet-picker { min-width: 72px; height: 26px; line-height: 26px; font-size: 11px; border-radius: 6px; border-width: 1px; }
}
