.tile {
  width: 92rpx; height: 128rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 6rpx; box-sizing: border-box;
  border-radius: 12rpx;
  background: #f6f2e4;
  box-shadow: 0 4rpx 0 #b9ad8c, 0 6rpx 14rpx rgba(0,0,0,.25);
}
.tile.small { width: 56rpx; height: 78rpx; padding: 4rpx; border-radius: 8rpx; box-shadow: 0 3rpx 0 #b9ad8c; }
.tile.tiny { width: 40rpx; height: 56rpx; padding: 3rpx; border-radius: 6rpx; box-shadow: 0 2rpx 0 #b9ad8c; }
/* 手牌：13 张加上刚摸的一张，正好一屏排完，不用左右滑 */
/* 手牌：13 张加上刚摸的一张，正好一屏排完，不用左右滑 */
.tile.hand {
  width: 48rpx; height: 68rpx;
  padding: 3rpx;
  border-radius: 8rpx;
  box-shadow: 0 3rpx 0 #b9ad8c;
  transition: margin-top .16s ease, box-shadow .16s ease;
}
/* 刚摸到的那张描一圈金边，和手里原有的区分开 */
.tile.fresh { box-shadow: 0 3rpx 0 #b9ad8c, 0 0 0 3rpx #efc85f; }
/* 选中时牌往上抬。不能用 transform——那样牌会移出组件宿主节点的边界被裁掉，
   .my-hand 上加多少 padding 都没用，裁切发生在更内层。
   改用负 margin 把牌顶进宿主预留的空间里（见页面里的 .hand-tile），
   位移成了布局的一部分，谁都裁不着。 */
.tile.selected {
  margin-top: -18rpx;
  border: 2rpx solid #e0c069;
  box-shadow: 0 8rpx 0 #b9ad8c, 0 12rpx 22rpx rgba(0,0,0,.35);
}
.tile-face { width: 100%; height: 100%; }
.tile-text { color: #1d2b25; font-size: 30rpx; font-weight: 700; }

.tile.concealed { background: #1d5546; box-shadow: 0 4rpx 0 #123b31; }
.tile-back {
  width: 100%; height: 100%;
  border-radius: 8rpx;
  background: repeating-linear-gradient(135deg, #24685500 0 8rpx, rgba(255,255,255,.05) 8rpx 16rpx), #216253;
}

/* 横屏下 rpx 的基准变成了长边，一张牌会撑到半个屏幕高，这里按 px 重新定尺寸 */
@media (orientation: landscape) {
  .tile { width: 46px; height: 64px; padding: 3px; border-radius: 6px; box-shadow: 0 2px 0 #b9ad8c, 0 3px 7px rgba(0,0,0,.25); }
  .tile.small { width: 28px; height: 39px; padding: 2px; border-radius: 4px; box-shadow: 0 2px 0 #b9ad8c; }
  .tile.tiny { width: 20px; height: 28px; padding: 1px; border-radius: 3px; box-shadow: 0 1px 0 #b9ad8c; }
  .tile.hand { width: 32px; height: 44px; padding: 2px; border-radius: 5px; box-shadow: 0 2px 0 #b9ad8c; }
  .tile.selected { margin-top: -10px; border-width: 1px; box-shadow: 0 4px 0 #b9ad8c, 0 6px 12px rgba(0,0,0,.35); }
  .tile.fresh { box-shadow: 0 2px 0 #b9ad8c, 0 0 0 2px #efc85f; }
  .tile-text { font-size: 15px; }
}
