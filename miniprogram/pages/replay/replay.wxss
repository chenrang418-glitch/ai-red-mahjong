.page { height: 100vh; display: flex; flex-direction: column; background: #0b1a15; box-sizing: border-box; }
.page-head { flex: none; padding: 12rpx 24rpx 16rpx; display: flex; align-items: center; gap: 18rpx; }
.back {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #2f4b41; border-radius: 16rpx;
  color: #cbd6d0; font-size: 36rpx; line-height: 1;
}
.page-title { color: #f3d67c; font-size: 34rpx; font-weight: 800; }
.head-btn {
  margin-left: auto;
  padding: 8rpx 22rpx;
  border: 2rpx solid #35524a; border-radius: 99rpx;
  color: #d9c489; font-size: 22rpx;
}
.page-body { flex: 1; min-height: 0; padding: 8rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }

.empty { padding: 80rpx 0; text-align: center; }
.empty-title { display: block; color: #8ba49c; font-size: 28rpx; font-weight: 700; }
.empty-text { display: block; margin-top: 10rpx; color: #63776f; font-size: 22rpx; line-height: 1.6; }

.replay-item {
  padding: 20rpx 22rpx; margin-bottom: 14rpx;
  border: 2rpx solid #2f4b41; border-radius: 20rpx; background: #102821;
}
.replay-title { display: block; color: #f0e6cb; font-size: 27rpx; font-weight: 700; }
.replay-meta { display: block; margin-top: 6rpx; color: #7f948d; font-size: 21rpx; }
.replay-actions { margin-top: 14rpx; display: flex; gap: 12rpx; }
.mini-btn {
  padding: 8rpx 20rpx;
  border: 2rpx solid #35524a; border-radius: 99rpx;
  color: #cfd8d3; font-size: 21rpx;
}
.mini-btn.danger { border-color: #5c3f3a; color: #c98f88; }

@media (orientation: landscape) {
  .page-head { padding: 6px 14px 8px; gap: 10px; }
  .back { width: 28px; height: 28px; border-radius: 8px; font-size: 18px; border-width: 1px; }
  .page-title { font-size: 16px; }
  .head-btn { padding: 3px 11px; font-size: 11px; border-width: 1px; }
  .page-body { padding: 4px 18px calc(14px + env(safe-area-inset-bottom)); }
  .empty { padding: 34px 0; }
  .empty-title { font-size: 13px; }
  .empty-text { margin-top: 5px; font-size: 10px; }
  .replay-item { padding: 9px 11px; margin-bottom: 7px; border-radius: 10px; border-width: 1px; }
  .replay-title { font-size: 13px; }
  .replay-meta { margin-top: 3px; font-size: 10px; }
  .replay-actions { margin-top: 7px; gap: 6px; }
  .mini-btn { padding: 3px 10px; font-size: 10px; border-width: 1px; }
}
