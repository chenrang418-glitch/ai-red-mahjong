.home {
  min-height: 100vh;
  padding: 0 36rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  /* 两团光晕压在对角，和网页版同一套底 */
  background:
    radial-gradient(circle at 10% 0, #28493e 0, transparent 34%),
    radial-gradient(circle at 90% 100%, #3a2520 0, transparent 30%),
    #091410;
  box-sizing: border-box;
}

.hero {
  position: relative;
  flex: none;
  padding: 28rpx 0 4rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  animation: rise .42s ease both;
}
.hero-kicker { color: #d6b765; font-size: 20rpx; font-weight: 800; letter-spacing: .22em; }
.hero-title { font-size: 76rpx; font-weight: 800; letter-spacing: -.04em; line-height: 1; color: #f6f0df; }
.hero-sub { color: #91a69f; font-size: 24rpx; }
/* 印章歪着盖，和网页版一样 */
.hero-seal {
  position: absolute;
  right: 0; top: 24rpx;
  width: 96rpx; height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid #bd4b43; border-radius: 24rpx;
  color: #d1584e; font-size: 52rpx; font-weight: 800;
  transform: rotate(7deg);
  animation: seal-in .6s .12s ease both;
}

/* 未完成的牌局 */
.resume-card {
  flex: none;
  padding: 22rpx 26rpx;
  border: 2rpx solid #6b5c31; border-radius: 24rpx;
  background: rgba(38, 34, 18, .8);
  animation: rise .42s .03s ease both;
}
.resume-head { display: flex; align-items: baseline; gap: 14rpx; }
.resume-tag { color: #d6b765; font-size: 20rpx; font-weight: 800; letter-spacing: .16em; }
.resume-round { color: #f6f0df; font-size: 30rpx; font-weight: 800; }
.resume-players { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.resume-player {
  padding: 5rpx 12rpx;
  border: 2rpx solid #4a4227; border-radius: 99rpx;
  color: #b6ab86; font-size: 19rpx;
}
.resume-player.me { border-color: #97854a; color: #f0d68a; }
.resume-actions { margin-top: 16rpx; display: flex; align-items: center; gap: 14rpx; }
.resume-drop {
  padding: 10rpx 22rpx;
  border: 2rpx solid #5c3f3a; border-radius: 99rpx;
  color: #c98f88; font-size: 22rpx;
}
.resume-go {
  flex: 1;
  height: 68rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; background: #e5c66d;
  color: #20261d; font-size: 26rpx; font-weight: 800;
}

/* 两张卡把剩下的高度分掉，各占一半 */
.cards { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 22rpx; }

.mode-card {
  position: relative;
  flex: 1;
  min-height: 0;
  padding: 30rpx 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 2rpx solid #345047; border-radius: 30rpx;
  background: rgba(14, 34, 29, .94);
  box-shadow: 0 24rpx 60rpx rgba(0,0,0,.3);
  animation: rise .46s ease both;
}
.local-card { animation-delay: .06s; }
.replay-card {
  animation-delay: .13s;
  border-color: #4a5c47;
  background: linear-gradient(145deg, rgba(24,42,35,.96), rgba(26,38,26,.96));
}
/* 角落那团光，卡片一按下去会亮一点 */
.mode-card::after {
  content: '';
  position: absolute;
  right: -70rpx; bottom: -80rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: rgba(224, 194, 105, .05);
  transition: background .2s;
}
.mode-card:active { transform: scale(.985); }
.mode-card:active::after { background: rgba(224, 194, 105, .1); }

.card-tag { color: #758b84; font-size: 19rpx; font-weight: 800; letter-spacing: .2em; }
.card-icon {
  width: 92rpx; height: 92rpx;
  margin-top: 22rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx;
  background: #23463b; color: #ebce76;
  font-size: 40rpx; font-weight: 900;
  animation: float 3.6s ease-in-out infinite;
}
.replay-card .card-icon { background: #2f4a33; color: #cfe6bf; animation-delay: .5s; }

.card-title { margin: 18rpx 0 10rpx; font-size: 46rpx; font-weight: 800; color: #f6f0df; }
.card-desc { color: #98aaa4; font-size: 24rpx; line-height: 1.65; }

.card-marks { margin: auto 0 24rpx; padding-top: 20rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.mark {
  padding: 8rpx 14rpx;
  border: 2rpx solid #2f4c43; border-radius: 99rpx;
  color: #c8bc94; font-size: 19rpx;
}

.card-btn {
  position: relative;
  z-index: 1;
  height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx;
  background: #e5c66d; color: #20261d;
  font-size: 30rpx; font-weight: 900;
}
.card-btn.replay { background: #8fbf7a; color: #16240f; }

.home-foot {
  flex: none;
  display: flex; justify-content: center; flex-wrap: wrap; gap: 18rpx;
  color: #6f847d; font-size: 20rpx;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(24rpx); }
}
@keyframes seal-in {
  from { opacity: 0; transform: rotate(-14deg) scale(.7); }
}
@keyframes float {
  50% { transform: translateY(-8rpx); }
}

/* 横屏：两张卡并排，高度不够竖着堆 */
@media (orientation: landscape) {
  .resume-card { padding: 8px 12px; border-radius: 10px; border-width: 1px; }
  .resume-tag { font-size: 9px; }
  .resume-round { font-size: 14px; }
  .resume-players { margin-top: 4px; gap: 4px; }
  .resume-player { padding: 2px 6px; font-size: 9px; border-width: 1px; }
  .resume-actions { margin-top: 7px; gap: 7px; }
  .resume-drop { padding: 4px 11px; font-size: 10px; border-width: 1px; }
  .resume-go { height: 30px; border-radius: 8px; font-size: 12px; }
  .home { padding: 0 20px 12px; gap: 10px; }
  .hero { padding: 8px 0 0; gap: 3px; }
  .hero-kicker { font-size: 10px; }
  .hero-title { font-size: 30px; }
  .hero-sub { font-size: 11px; }
  .hero-seal { width: 44px; height: 44px; border-width: 2px; border-radius: 11px; font-size: 24px; top: 6px; }
  .cards { flex-direction: row; gap: 12px; }
  .mode-card { padding: 12px 14px; border-radius: 14px; border-width: 1px; }
  .card-tag { font-size: 9px; }
  .card-icon { width: 38px; height: 38px; margin-top: 8px; border-radius: 10px; font-size: 17px; }
  .card-title { margin: 8px 0 4px; font-size: 20px; }
  .card-desc { font-size: 11px; line-height: 1.5; }
  .card-marks { margin-bottom: 10px; padding-top: 8px; gap: 5px; }
  .mark { padding: 3px 7px; font-size: 9px; border-width: 1px; }
  .card-btn { height: 40px; border-radius: 9px; font-size: 14px; }
  .home-foot { gap: 9px; font-size: 9px; }
}
