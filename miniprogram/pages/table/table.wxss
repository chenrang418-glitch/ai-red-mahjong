.table-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at 50% 18%, #1d4c3f, transparent 60%), #0b1a15;
  box-sizing: border-box;
}

/* 高度和上边距都按胶囊算：内容跟胶囊同一条水平线，就不会顶到灵动岛里。
   走 CSS 变量而不是内联样式，横屏才有机会覆盖。 */
.topbar {
  flex: none;
  height: var(--nav-height, 88rpx);
  padding: var(--nav-top, 44rpx) var(--menu-gap, 100rpx) 0 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.quit {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #2f4b41; border-radius: 16rpx;
  color: #cbd6d0; font-size: 36rpx; line-height: 1;
}
.round-info { display: flex; gap: 20rpx; }
.round-item { font-size: 22rpx; color: #8ba49c; }
.round-item .strong { color: #f3d67c; font-size: 26rpx; font-weight: 800; }

/* 牌桌本体占满中间，手牌区固定在下面 */
.board {
  flex: 1;
  min-height: 0;
  padding: 8rpx 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.seat {
  padding: 14rpx 18rpx;
  border: 2rpx solid #274038; border-radius: 18rpx;
  background: rgba(11, 32, 26, .72);
}
/* 轮到谁就把谁的框亮起来，一眼看出牌在谁那儿 */
.seat.active { border-color: #d3b45e; background: rgba(30, 58, 47, .9); }
.seat-top { align-self: center; min-width: 300rpx; }
.seat-head { display: flex; align-items: center; gap: 10rpx; }
.dealer {
  width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center;
  border-radius: 50%; background: #a8342c; color: #ffe9d0; font-size: 20rpx;
}
.seat-name { font-size: 26rpx; font-weight: 700; color: #e8dfc6; }
.seat-points { font-size: 22rpx; color: #b3a375; }
.seat-meta { margin-top: 6rpx; }
.hand-count {
  display: inline-block;
  padding: 4rpx 14rpx;
  border: 2rpx solid #35524a; border-radius: 99rpx;
  color: #9db4ac; font-size: 20rpx;
}
.seat-melds { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.meld { display: flex; gap: 2rpx; }

.middle {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.seat-side {
  width: 156rpx;
  align-self: center;
  display: flex; flex-direction: column; gap: 6rpx;
}

.river {
  flex: 1;
  min-width: 0;
  max-height: 100%;
  padding: 10rpx;
  display: flex; flex-direction: column; gap: 6rpx;
  border: 2rpx solid rgba(52, 82, 72, .5);
  border-radius: 18rpx;
  background: rgba(6, 24, 19, .5);
  overflow-y: auto;
}
/* 每行：左边谁打的，右边那一排牌 */
.river-row { display: flex; align-items: flex-start; gap: 8rpx; min-height: 60rpx; }
.river-who {
  flex: none;
  width: 56rpx; padding-top: 6rpx;
  color: #74897f; font-size: 19rpx;
}
.river-tiles { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; gap: 3rpx; }

.notice {
  padding: 10rpx 0;
  text-align: center;
  color: #ddc68c; font-size: 24rpx;
}
/* 刚打出的那张牌闪一下，四家轮得快的时候才跟得上 */
.last-action {
  margin: 0 auto;
  padding: 8rpx 20rpx;
  align-self: center;
  border: 2rpx solid rgba(179, 148, 74, .5); border-radius: 99rpx;
  background: rgba(44, 42, 23, .8);
  color: #ffe08a; font-size: 23rpx; font-weight: 700;
  animation: action-flash .32s ease;
}
@keyframes action-flash {
  from { opacity: .25; transform: translateY(-6rpx); }
}
/* 轮到自己时整张桌子轻轻呼吸，不用盯着文字也知道该我了 */
.board.my-turn .river { animation: table-breathe 2.4s ease-in-out infinite; }
@keyframes table-breathe {
  50% { border-color: rgba(243, 202, 105, .55); }
}

.my-area {
  flex: none;
  padding: 14rpx 20rpx 20rpx;
  display: flex; flex-direction: column; gap: 12rpx;
  border-top: 2rpx solid #274038;
  background: rgba(9, 26, 21, .96);
}
.my-head { display: flex; align-items: center; justify-content: space-between; }
.my-name { font-size: 28rpx; font-weight: 800; color: #f0e6cb; }
.my-points { font-size: 24rpx; color: #d9c489; }
.my-melds { display: flex; flex-wrap: wrap; gap: 10rpx; }

/* 普通 view 而不是 scroll-view：scroll-view 会按自身高度裁切，
   而手牌宿主要给抬起的牌留出空间，高度本来就比牌高一截。
   竖屏换行、横屏一行都排得下，也用不上滚动。 */
.my-hand {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-end;
  gap: 5rpx;
  padding: 6rpx 0;
}
/* 每张手牌的宿主都预留 18rpx，选中的那张用负 margin 顶进去，
   位移成了布局的一部分，不会像 transform 那样被宿主边界裁掉。
   高度必须写死：手牌区是底对齐的，宿主高度一跟着内容缩，牌就抬不起来了。 */
.hand-tile {
  display: block;
  height: 86rpx;
  padding-top: 18rpx;
}

/* 刚摸的那张单独放右边，中间一道竖线隔开——和网页版一样，
   一眼看出哪张是新来的，不用在十四张里数 */
.drawn-slot {
  position: relative;
  margin-left: 14rpx;
  padding-left: 14rpx;
  display: flex;
}
.drawn-slot::before {
  content: '';
  position: absolute;
  left: 0; top: 20rpx; bottom: 4rpx;
  width: 2rpx;
  background: rgba(243, 202, 105, .45);
}
.drawn-slot .drawn-tag {
  position: absolute;
  z-index: 2;
  top: 0; left: 16rpx;
  padding: 1rpx 8rpx;
  border-radius: 99rpx;
  background: #c49d3e;
  color: #17211b; font-size: 16rpx; font-weight: 800;
}

.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.action-btn {
  min-width: 108rpx; height: 76rpx;
  padding: 0 26rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #35524a; border-radius: 18rpx;
  background: #14302a; color: #e4dcc4;
  font-size: 28rpx; font-weight: 700;
}
.action-btn.gold { border-color: #b3944a; background: #2c2a17; color: #f3d67c; }
.action-btn.primary { flex: 1; border: 0; background: #e0c069; color: #20261e; }
.action-btn.disabled { background: #253029; color: #7b8a83; }
.action-hint { flex: 1; text-align: center; color: #8ba49c; font-size: 24rpx; }
/* 抢牌倒计时。小程序里画不了 SVG 环，用 conic-gradient 涂一圈，
   中间盖一个实心圆挖空，效果和网页版那个环一样。 */
.claim-ring {
  position: relative;
  flex: none;
  width: 76rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: conic-gradient(#eac75f var(--ring, 100%), rgba(255,255,255,.13) 0);
  transition: background .2s linear;
}
.claim-ring-core {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: #041b17;
  color: #f5d16f; font-size: 28rpx; font-weight: 800;
}
/* 剩两秒开始催 */
.claim-ring.urgent { background: conic-gradient(#ef6559 var(--ring, 100%), rgba(255,255,255,.13) 0); animation: ring-pulse .7s ease-in-out infinite alternate; }
.claim-ring.urgent .claim-ring-core { color: #ff8b7d; }
@keyframes ring-pulse {
  to { transform: scale(1.07); }
}

.result-mask {
  position: fixed; inset: 0; z-index: 20;
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
  background: rgba(0,0,0,.68);
}
.result-card {
  width: 100%;
  padding: 40rpx 36rpx;
  display: flex; flex-direction: column; gap: 16rpx;
  border: 2rpx solid #806d38; border-radius: 28rpx;
  background: #0e241e;
}
.result-tag { font-size: 20rpx; letter-spacing: .2em; color: #7d918a; }
.result-title { font-size: 34rpx; font-weight: 800; color: #f3d67c; line-height: 1.4; }
.result-tiles {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #2f4b41; border-radius: 16rpx;
  background: #12312a;
}
.result-label { margin-right: 6rpx; color: #8fa49c; font-size: 21rpx; }
.result-scores { max-height: 320rpx; }
.result-score-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 14rpx; margin-bottom: 6rpx;
  border-radius: 12rpx; background: #142e27;
}
.result-score-name { flex: none; color: #eee4c8; font-size: 25rpx; font-weight: 700; }
.result-score-name.me { color: #f3d67c; }
.result-score-stat { flex: 1; min-width: 0; color: #71867f; font-size: 19rpx; }
.result-score-value { color: #efd070; font-size: 25rpx; font-weight: 800; }
.result-actions { margin-top: 8rpx; display: flex; gap: 16rpx; }

.topbar-actions { margin-left: auto; display: flex; gap: 10rpx; }
.panel-entry {
  padding: 8rpx 20rpx;
  border: 2rpx solid #35524a; border-radius: 99rpx;
  color: #d9c489; font-size: 22rpx;
}

.panel-mask { position: fixed; inset: 0; z-index: 24; background: rgba(0,0,0,.42); }
/* 从底部滑上来，关掉时留在屏幕外，不用 v-if 反复销毁重建 */
.panel {
  position: fixed; z-index: 25;
  left: 0; right: 0; bottom: 0;
  height: min(72vh, 900rpx);
  display: flex; flex-direction: column;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid #35524a;
  background: #0c211b;
  visibility: hidden;
  transform: translateY(102%);
  transition: transform .22s ease, visibility .22s;
  padding-bottom: env(safe-area-inset-bottom);
}
.panel.open { visibility: visible; transform: translateY(0); }
.panel-tabs { flex: none; display: flex; align-items: center; gap: 10rpx; padding: 18rpx 20rpx; border-bottom: 2rpx solid #1d352d; }
.panel-tab {
  flex: 1; text-align: center;
  padding: 14rpx 0;
  border: 2rpx solid #2b453d; border-radius: 14rpx;
  color: #9db4ac; font-size: 24rpx;
}
.panel-tab.active { border-color: #d3b45e; background: #1b3a31; color: #f3d67c; font-weight: 700; }
.panel-close { flex: none; width: 56rpx; text-align: center; color: #8ba49c; font-size: 40rpx; line-height: 1; }
.panel-body { flex: 1; min-height: 0; padding: 16rpx 20rpx 24rpx; }
.panel-empty { padding: 40rpx 0; text-align: center; color: #63776f; font-size: 24rpx; }

.rank-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 16rpx; margin-bottom: 10rpx; border-radius: 16rpx; background: #122d26; }
.rank-no { width: 40rpx; color: #d3b45e; font-size: 26rpx; font-weight: 800; }
.rank-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.rank-name { color: #eee4c8; font-size: 27rpx; font-weight: 700; }
.rank-name.me { color: #f3d67c; }
.rank-stat { color: #74897f; font-size: 20rpx; }
.rank-score { color: #efd070; font-size: 27rpx; font-weight: 800; }

.flow-row { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 16rpx; margin-bottom: 8rpx; border-radius: 14rpx; background: #122d26; }
.flow-reason { flex: none; padding: 4rpx 12rpx; border-radius: 99rpx; background: #1d3f34; color: #9fd0b4; font-size: 20rpx; }
.flow-path { flex: 1; min-width: 0; color: #c5d0cb; font-size: 23rpx; }
.flow-paid { color: #efd070; font-size: 24rpx; font-weight: 700; }
.flow-short { color: #c98f88; font-size: 20rpx; font-weight: 400; }

.log-row { display: flex; gap: 12rpx; padding: 12rpx 16rpx; margin-bottom: 6rpx; border-radius: 12rpx; background: #102520; }
.log-round { flex: none; color: #6f857c; font-size: 20rpx; }
.log-detail { flex: 1; min-width: 0; color: #c5d0cb; font-size: 23rpx; line-height: 1.5; }

/* —— 横屏 ——
   注意 rpx 的基准是屏幕宽度：竖屏 750rpx = 390px，横屏 750rpx = 844px，
   同一个 rpx 值在横屏会被放大两倍多，整页直接撑爆。所以横屏这一段全部用 px。 */
@media (orientation: landscape) {
  /* 横屏时刘海/灵动岛跑到左侧，Home Indicator 在底部，两边都得留出来，
     否则左家的座位卡和手牌会被硬件挡住 */
  .table-page {
    height: 100vh;
    overflow: hidden;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }

  /* 胶囊坐标在横屏下不一定及时更新，这里给 padding-right 兜一个下限 */
  .topbar {
    height: 38px;
    padding: 2px max(var(--menu-gap, 100px), 104px) 0 12px;
    gap: 10px;
  }
  .quit { width: 26px; height: 26px; border-radius: 7px; font-size: 17px; }
  .round-item { font-size: 11px; }
  .round-item .strong { font-size: 13px; }
  .panel-entry { padding: 3px 10px; font-size: 11px; }

  .board { padding: 2px 10px 0; gap: 4px; }
  .seat { padding: 5px 8px; border-radius: 8px; border-width: 1px; }
  .seat-top { min-width: 150px; }
  .seat-top .seat-melds { display: none; }
  .seat-name { font-size: 13px; }
  .seat-points { font-size: 11px; }
  .hand-count { padding: 1px 7px; font-size: 10px; border-width: 1px; }
  .dealer { width: 17px; height: 17px; line-height: 17px; font-size: 10px; }

  .middle { gap: 6px; }
  .seat-side { width: 92px; gap: 3px; }
  .river { padding: 5px 6px; gap: 3px; border-radius: 9px; border-width: 1px; }
  .river-row { min-height: 26px; gap: 5px; }
  .river-who { width: 28px; padding-top: 3px; font-size: 10px; }
  .river-tiles { gap: 2px; }

  .last-action { padding: 2px 10px; font-size: 11px; border-width: 1px; }
  .notice { padding: 2px 0; font-size: 11px; }

  /* 底部一整行：副露、手牌、操作按钮并排，高度省下来给牌桌 */
  .my-area {
    flex: none;
    flex-direction: row;
    align-items: flex-end;
    gap: 10px;
    padding: 4px 10px calc(10px + env(safe-area-inset-bottom));
    border-top-width: 1px;
  }
  /* 名字和积分挪到最左边竖排，横屏也得看得见自己有多少分 */
  .my-head {
    order: 0;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1px;
    padding-bottom: 2px;
  }
  .my-name { font-size: 13px; }
  .my-points { font-size: 12px; }
  .my-melds { order: 1; flex: none; max-width: 120px; gap: 5px; }
  .my-hand { order: 2; flex: 1; min-width: 0; flex-wrap: nowrap; gap: 3px; padding: 2px 0; }
  .actions { order: 3; flex: none; width: 150px; gap: 6px; padding-bottom: 2px; }
  .action-btn { min-width: 52px; height: 34px; padding: 0 10px; border-radius: 9px; font-size: 13px; border-width: 1px; }
  .action-btn.primary { flex: 1 0 100%; }
  .action-hint { font-size: 11px; }
  .claim-ring { width: 34px; height: 34px; }
  .claim-ring-core { width: 27px; height: 27px; font-size: 13px; }

  /* 手牌尺寸也得换成 px，否则一张牌会有半个屏幕高 */
  .hand-tile { height: 54px; padding-top: 10px; }
  .drawn-slot { margin-left: 7px; padding-left: 7px; }
  .drawn-slot::before { top: 10px; bottom: 2px; width: 1px; }
  .drawn-slot .drawn-tag { left: 8px; padding: 0 4px; font-size: 8px; }

  /* 面板改成右侧抽屉：从下面推上来会盖住整张桌子 */
  .panel {
    left: auto; top: 0; right: env(safe-area-inset-right); bottom: 0;
    width: min(58vw, 360px);
    height: 100vh;
    border-radius: 14px 0 0 14px;
    border-top: 0;
    border-left: 1px solid #35524a;
    transform: translateX(102%);
  }
  .panel.open { visibility: visible; transform: translateX(0); }
  .panel-tabs { padding: 8px 10px; gap: 6px; }
  .panel-tab { padding: 6px 0; border-radius: 8px; font-size: 11px; border-width: 1px; }
  .panel-close { width: 28px; font-size: 22px; }
  .panel-body { padding: 8px 10px 12px; }
  .rank-row { padding: 9px 10px; margin-bottom: 5px; border-radius: 9px; gap: 9px; }
  .rank-no { width: 20px; font-size: 13px; }
  .rank-name { font-size: 13px; }
  .rank-stat { font-size: 10px; }
  .rank-score { font-size: 13px; }
  .flow-row { padding: 7px 10px; margin-bottom: 4px; border-radius: 8px; gap: 7px; }
  .flow-reason { padding: 2px 7px; font-size: 10px; }
  .flow-path { font-size: 11px; }
  .flow-paid { font-size: 12px; }
  .log-row { padding: 6px 10px; margin-bottom: 3px; border-radius: 7px; gap: 7px; }
  .log-round { font-size: 10px; }
  .log-detail { font-size: 11px; }

  /* 横屏只有 390 高，竖着堆会拉满整屏。改成左右两栏：
     左边胡了什么，右边谁得了多少分，按钮收在左下角。 */
  .result-mask { padding: 10px; }
  .result-card {
    width: min(620px, 94vw);
    max-height: 94vh;
    padding: 12px 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      "tag     scores"
      "title   scores"
      "win     scores"
      "ma      scores"
      "actions scores";
    gap: 5px 14px;
    border-radius: 14px;
    border-width: 1px;
  }
  .result-tag { grid-area: tag; font-size: 9px; }
  .result-title { grid-area: title; font-size: 16px; line-height: 1.3; }
  .win-tiles { grid-area: win; align-self: start; }
  .ma-tiles { grid-area: ma; align-self: start; }
  .result-tiles { padding: 5px 8px; gap: 4px; border-radius: 8px; border-width: 1px; }
  .result-label { font-size: 10px; margin-right: 3px; }
  .result-scores { grid-area: scores; max-height: none; min-height: 0; }
  .result-score-row { padding: 5px 8px; margin-bottom: 3px; border-radius: 7px; gap: 7px; }
  .result-score-name { font-size: 12px; }
  .result-score-stat { font-size: 10px; }
  .result-score-value { font-size: 12px; }
  .result-actions { grid-area: actions; align-self: end; margin-top: 4px; gap: 8px; }
}

/* —— 开局投骰 —— */
.dice-toast {
  position: fixed; z-index: 30;
  left: 50%; top: 22%;
  transform: translateX(-50%);
  width: min(560rpx, 84vw);
  padding: 26rpx 30rpx;
  display: flex; flex-direction: column; gap: 14rpx;
  border: 2rpx solid #927b3e; border-radius: 24rpx;
  background: rgba(13, 35, 29, .97);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.45);
  animation: dice-in .3s ease;
}
.dice-tag { color: #7d918a; font-size: 20rpx; letter-spacing: .2em; text-align: center; }
.dice-list { display: flex; flex-direction: column; gap: 8rpx; }
.dice-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx; background: #142e27;
}
.dice-row.is-dealer { background: #2c2a17; }
.dice-name { flex: 1; min-width: 0; color: #e8dfc6; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dice-pips { flex: none; display: flex; gap: 8rpx; }
/* 骰子点数用小方块表示，比纯数字像那么回事 */
.pip {
  flex: none;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 8rpx; background: #f4efe0;
  color: #1d2b25; font-size: 24rpx; font-weight: 800;
  animation: pip-roll .4s ease;
}
.dice-total { min-width: 44rpx; text-align: right; color: #f3d67c; font-size: 26rpx; font-weight: 800; }
.dice-dealer { text-align: center; color: #f3d67c; font-size: 26rpx; font-weight: 800; }
@keyframes dice-in { from { opacity: 0; transform: translateX(-50%) translateY(-14rpx); } }
@keyframes pip-roll { from { transform: rotate(-90deg) scale(.6); } }

/* —— 通用底部弹层：规则、AI 档位共用 —— */
/* 牌桌专属的横屏适配。弹层（sheet / more / audio / ai）那套是两个页面共用的，
   放在 app.wxss 里，别再往这里塞——之前竖屏定义混进媒体块里，横屏就失效了。 */
@media (orientation: landscape) {
  .dice-toast { top: 12%; width: min(420px, 70vw); padding: 12px 16px; gap: 7px; border-radius: 12px; border-width: 1px; }
  .dice-tag { font-size: 9px; }
  .dice-row { padding: 5px 8px; gap: 8px; border-radius: 7px; }
  .dice-name { font-size: 12px; }
  .pip { width: 20px; height: 20px; line-height: 20px; font-size: 12px; border-radius: 4px; }
  .dice-total { min-width: 22px; font-size: 13px; }
  .dice-dealer { font-size: 13px; }
  .topbar-actions { gap: 5px; }
}
