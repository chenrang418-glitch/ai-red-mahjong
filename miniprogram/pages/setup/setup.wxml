<view class="setup safe-bottom" style="padding-top: {{navHeight}}px">
  <view class="setup-head" style="padding-right: {{menuGap}}px">
    <view class="back" bindtap="goBack">‹</view>
    <text class="setup-title">开局设置</text>
    <view class="head-actions">
      <view class="head-btn" bindtap="openReplays">牌谱</view>
      <view class="head-btn" bindtap="openAudio">声音</view>
      <view class="head-btn" bindtap="openRules">规则</view>
    </view>
  </view>

  <scroll-view class="setup-body" scroll-y>
    <view class="field">
      <text class="field-label">计分方式</text>
      <view class="options row">
        <view class="option {{mode === 'finite' ? 'active' : ''}}" data-value="finite" bindtap="pickMode">
          <text class="option-name">有限积分</text>
          <text class="option-desc">分光就结束</text>
        </view>
        <view class="option {{mode === 'unlimited' ? 'active' : ''}}" data-value="unlimited" bindtap="pickMode">
          <text class="option-name">无限模式</text>
          <text class="option-desc">只记净分</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">座位</text>
      <view class="players">
        <view class="player-row" wx:for="{{players}}" wx:key="index">
          <view class="player-tag {{item.human ? 'human' : ''}}">{{item.human ? '你' : 'AI'}}</view>
          <input
            class="player-name"
            value="{{item.name}}"
            maxlength="8"
            data-index="{{index}}"
            bindinput="changeName"
          />
          <picker
            wx:if="{{!item.human}}"
            class="player-level"
            range="{{difficultyLabels}}"
            value="{{item.levelIndex}}"
            data-index="{{index}}"
            bindchange="changeLevel"
          >
            <view class="picker-box">{{difficultyLabels[item.levelIndex]}} ›</view>
          </picker>
          <view wx:else class="player-level placeholder">下方座位</view>
        </view>
      </view>
    </view>

    <view class="field" wx:if="{{mode === 'finite'}}">
      <text class="field-label">初始积分</text>
      <view class="stepper">
        <view class="step-btn" bindtap="decPoints">−</view>
        <input
          class="step-value"
          type="number"
          value="{{initialPoints}}"
          bindinput="inputPoints"
          bindblur="normalizePoints"
        />
        <view class="step-btn" bindtap="incPoints">+</view>
      </view>
    </view>

    <view class="field">
      <view class="field-inline">
        <text class="field-label">抢牌窗口</text>
        <picker
          class="inline-picker"
          range="{{claimWindowLabels}}"
          value="{{claimWindowIndex}}"
          bindchange="changeClaimWindow"
        >
          <view class="picker-box">{{claimWindowLabels[claimWindowIndex]}} ›</view>
        </picker>
      </view>
    </view>
  </scroll-view>

  <!-- 声音：和牌桌页同一套小窗 -->
  <view wx:if="{{audioOpen}}" class="sheet-mask" bindtap="closeAudio"></view>
  <view wx:if="{{audioOpen}}" class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">声音</text>
      <view class="sheet-close" bindtap="closeAudio">×</view>
    </view>
    <view class="sheet-body">
      <view class="sheet-row">
        <text class="sheet-row-name">音效</text>
        <switch checked="{{audio.effectsEnabled}}" data-key="effectsEnabled" bindchange="toggleAudio" color="#d9b95f" />
      </view>
      <view class="sheet-slider">
        <text class="sheet-slider-label">音效音量 {{audio.effectsVolume}}</text>
        <slider value="{{audio.effectsVolume}}" min="0" max="100" data-key="effectsVolume" bindchange="changeVolume" activeColor="#d9b95f" block-size="18" />
      </view>
      <view class="sheet-row">
        <text class="sheet-row-name">背景音乐</text>
        <switch checked="{{audio.musicEnabled}}" data-key="musicEnabled" bindchange="toggleAudio" color="#d9b95f" />
      </view>
      <view class="sheet-slider">
        <text class="sheet-slider-label">音乐音量 {{audio.musicVolume}}</text>
        <slider value="{{audio.musicVolume}}" min="0" max="100" data-key="musicVolume" bindchange="changeVolume" activeColor="#d9b95f" block-size="18" />
      </view>
      <view class="sheet-row">
        <text class="sheet-row-name">震动反馈</text>
        <switch checked="{{audio.vibrateEnabled}}" data-key="vibrateEnabled" bindchange="toggleAudio" color="#d9b95f" />
      </view>
    </view>
  </view>

  <!-- 上次没打完的牌局。放在开始按钮上方这块空地，比塞在首页显眼 -->
  <view wx:if="{{resume}}" class="resume-card">
    <view class="resume-head">
      <text class="resume-tag">上次没打完</text>
      <text class="resume-round">第 {{resume.round}} 局</text>
    </view>
    <view class="resume-players">
      <text
        class="resume-player {{item.isHuman ? 'me' : ''}}"
        wx:for="{{resume.players}}"
        wx:key="name"
      >{{item.name}} {{item.score}}</text>
    </view>
    <view class="resume-actions">
      <view class="resume-btn drop" bindtap="dropMatch">删除</view>
      <view class="resume-btn go" bindtap="continueMatch">继续</view>
    </view>
  </view>

  <view class="setup-foot">
    <view class="primary-btn" bindtap="startGame">开始牌局</view>
  </view>
</view>
